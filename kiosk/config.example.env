# Copy to /opt/nordic-crypto-kiosk/config.env and edit.

# API: raw GitHub avoids broken custom-domain HTTPS.
API_BASE=https://raw.githubusercontent.com/jQrgen/nordic-crypto/gh-pages
NEWS_PATH=/api/v1/news.json

# Where this kiosk app updates from (same repo, /kiosk/ on gh-pages).
UPDATE_BASE=https://raw.githubusercontent.com/jQrgen/nordic-crypto/gh-pages/kiosk
UPDATE_CHECK_HOURS=6

# Refresh news on screen (seconds).
NEWS_REFRESH_SEC=900
# Seconds between headline slides.
SLIDE_SEC=22

# Language for summary: en | nn | nb | sv | da | fi | is
LANG=en

# Chromium binary on Raspberry Pi OS (Bookworm often uses chromium).
CHROMIUM=chromium
# Display (default HDMI).
DISPLAY=:0
