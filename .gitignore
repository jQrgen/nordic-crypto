# Working files. data/ IS committed (public content, privacy-gated).
# state/ and queue/ stay off main. The nightly fetch workflow force-adds the editor
# queue onto the fetch-queue branch only. Never commit state/private_terms.json.
state/
queue/
logs/
site/
.publish/
.venv/
__pycache__/
*.pyc
shots/
/*.png
!/apple-touch-icon.png
.env
*.token
tools/probe.py
screenshots/
.publish/
tipserver/tips.db*
tipserver/*.log
tipserver/*.pid
tipserver/tunnel-url.txt
archive/articles.db
archive/articles.db-*

# Worker secrets, local wrangler/Miniflare state and npm installs, in every
# directory (never commit; publish.sh runs `git add -A`). .mf/ also catches a
# Miniflare cache outside node_modules/.
node_modules/
.wrangler/
.mf/
.dev.vars
.dev.vars.*
!.dev.vars.example
.env.*
!.env.example
.DS_Store

# generated newsletter digests (regenerate with newsletter/digest.py)
newsletter/out/

# local screenshot build of the tip page (tip server mode), never published
site-tip-preview/
tipserver/tunnel.state
